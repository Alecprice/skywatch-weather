{
  "name": "skywatch-weather",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run test:store && npm run test:geocode && npm run test:weather && npm run test:notifier && npm run test:registration && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:store": "node scripts/test-server-store.mjs",
    "test:geocode": "node scripts/test-geocode-policy.mjs",
    "test:alerts": "node scripts/test-monitor-alert-state.mjs",
    "test:weather": "node scripts/test-weather-codes.mjs",
    "test:notifier": "node scripts/test-notifier-transports.mjs",
    "test:registration": "node scripts/test-monitor-registration.mjs",
    "smoke:prod": "node scripts/smoke-production.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "16.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2",
    "@types/web-push": "^3.6.4"
  }
}
