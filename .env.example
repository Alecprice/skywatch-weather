# Required only for true background Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Durable monitor storage on Vercel/Upstash. Either naming convention works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Protect /api/cron/monitor when invoked outside Vercel Cron
CRON_SECRET=

# Optional email alerts (Resend)
RESEND_API_KEY=
ALERT_EMAIL_FROM=SkyWatch <alerts@example.com>

# Optional SMS alerts (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional verified lightning provider. Endpoint should accept ?lat=&lon=
# and return JSON such as {"nearestMiles":8.4,"strikes":[{"lat":36.2,"lon":-86.8,"time":"..."}]}
LIGHTNING_FEED_URL=

# Optional U.S./regional pollen provider. Endpoint accepts ?lat=&lon= and returns
# {grass,ragweed,birch,alder,mugwort} in grains/m3.
POLLEN_FEED_URL=

# Optional NASA FIRMS active-fire hotspot layer
FIRMS_MAP_KEY=
